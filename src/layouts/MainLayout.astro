---
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { buildTaxonomy } from '../lib/taxonomy';
import type { Video } from '../lib/taxonomy';
import { SITE_NAME, SITE_TAGLINE } from '../config/site.mjs';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  /** Optional JSON-LD (e.g. Schema.org VideoObject) injected into <head>. */
  jsonLd?: Record<string, unknown>;
  /** Full collection — powers the sidebar taxonomy tree. */
  videos?: Video[];
}

const { title, description, ogImage, ogType = 'website', jsonLd, videos = [] } = Astro.props;
const taxonomy = buildTaxonomy(videos);
const pageTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} — ${SITE_TAGLINE}`;
const pageDesc =
  description ??
  'A zero-database, Git-powered video streaming catalog built with Astro and Tailwind CSS. Tech, design, gaming and lifestyle — streamed from anywhere.';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="canonical" href={canonical} />

    <!-- OpenGraph / Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <!-- Schema.org structured data (VideoObject on detail pages) -->
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Theme bootstrap: no flash, dark by default -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('vv-theme');
          var dark = t ? t === 'dark' : true;
          document.documentElement.classList.toggle('dark', dark);
        } catch (e) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-zinc-50 text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100">
    <Header />

    <!--
      Shell: fixed header (4rem) + fixed sidebar rail (16rem from lg up).
      Both are out of the document flow, so the content column must be
      offset explicitly — pt-16 for the header, lg:pl-64 for the rail.
      Below lg the sidebar is an off-canvas drawer and the column is full-width.
    -->
    <div class="pt-16 lg:pl-64">
      <Sidebar taxonomy={taxonomy} total={videos.length} />
      <main id="main" class="min-w-0 px-4 pb-16 pt-6 sm:px-6 lg:px-8">
        <slot />
      </main>
    </div>

    <footer class="border-t border-black/5 bg-white dark:border-white/10 dark:bg-zinc-900/40 lg:pl-64">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <!-- Brand -->
          <div>
            <a href="/" class="flex items-center gap-2.5" aria-label={`${SITE_NAME} home`}>
              <img src="/logo.svg" alt={`${SITE_NAME} logo`} width="32" height="32" class="h-8 w-8" />
              <span class="text-lg font-extrabold tracking-tight">
                DESI<span class="bg-gradient-to-r from-pink-500 to-rose-500 bg-clip-text text-transparent">DUDE</span>
              </span>
            </a>
            <p class="mt-3 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
              {SITE_TAGLINE}. A zero-database streaming catalog — every video is a JSON file in Git,
              cataloged, searched and indexed automatically.
            </p>
          </div>

          <!-- Explore -->
          <nav aria-label="Footer — explore">
            <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-900 dark:text-zinc-100">Explore</h3>
            <ul class="mt-3 space-y-2 text-sm">
              <li><a href="/" class="text-zinc-500 transition hover:text-pink-500 dark:text-zinc-400 dark:hover:text-pink-400">Home</a></li>
              <li><a href="/?cat=" class="text-zinc-500 transition hover:text-pink-500 dark:text-zinc-400 dark:hover:text-pink-400">All videos</a></li>
              <li><a href="/sitemap.xml" class="text-zinc-500 transition hover:text-pink-500 dark:text-zinc-400 dark:hover:text-pink-400">Sitemap</a></li>
              <li><a href="/robots.txt" class="text-zinc-500 transition hover:text-pink-500 dark:text-zinc-400 dark:hover:text-pink-400">Robots.txt</a></li>
            </ul>
          </nav>

          <!-- Categories (generated from the JSON collection) -->
          <nav aria-label="Footer — categories">
            <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-900 dark:text-zinc-100">Categories</h3>
            <ul class="mt-3 space-y-2 text-sm">
              {taxonomy.slice(0, 5).map((cat) => (
                <li>
                  <a
                    href={`/?cat=${encodeURIComponent(cat.name)}`}
                    class="text-zinc-500 transition hover:text-pink-500 dark:text-zinc-400 dark:hover:text-pink-400"
                  >
                    {cat.name} <span class="text-xs opacity-60">({cat.count})</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <!-- Admin / meta -->
          <nav aria-label="Footer — admin">
            <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-900 dark:text-zinc-100">For admins</h3>
            <ul class="mt-3 space-y-2 text-sm">
              <li><a href="/admin" class="text-zinc-500 transition hover:text-pink-500 dark:text-zinc-400 dark:hover:text-pink-400">Admin panel</a></li>
              <li><a href="/admin" class="text-zinc-500 transition hover:text-pink-500 dark:text-zinc-400 dark:hover:text-pink-400">JSON builder</a></li>
              <li><a href="/admin" class="text-zinc-500 transition hover:text-pink-500 dark:text-zinc-400 dark:hover:text-pink-400">Git workflow</a></li>
            </ul>
            <p class="mt-4 text-xs leading-relaxed text-zinc-400 dark:text-zinc-500">
              {videos.length} videos · {taxonomy.length} categories · data lives in
              <code class="font-mono">src/content/videos/</code>
            </p>
          </nav>
        </div>

        <div
          class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-black/5 pt-6 text-xs text-zinc-500 dark:border-white/10 dark:text-zinc-400 sm:flex-row"
        >
          <p>© {new Date().getFullYear()} {SITE_NAME}. All rights reserved.</p>
          <p>Built with Astro 7.3.2 + Tailwind CSS · Schema.org indexed · Git-powered</p>
        </div>
      </div>
    </footer>
  </body>
</html>
