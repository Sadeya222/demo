---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Page not found">
  <div class="mx-auto flex max-w-md flex-col items-center py-24 text-center">
    <p class="bg-gradient-to-r from-pink-500 to-rose-500 bg-clip-text text-7xl font-black text-transparent">
      404
    </p>
    <h1 class="mt-4 text-xl font-bold">This stream has ended</h1>
    <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
      The page you're looking for doesn't exist in the catalog — the video may have been
      removed from the repository.
    </p>
    <a href="/" class="btn-primary mt-6">Back to catalog</a>
  </div>
</MainLayout>
