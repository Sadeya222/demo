---
import { SITE_NAME } from '../config/site.mjs';
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-black/5 bg-white/85 backdrop-blur-md dark:border-white/10 dark:bg-zinc-950/85"
>
  <div class="flex h-16 items-center gap-2 px-4 sm:gap-3 sm:px-6">
    <!-- Mobile: open the sidebar drawer -->
    <button
      id="menu-btn"
      type="button"
      class="rounded-lg p-2 text-zinc-600 hover:bg-black/5 dark:text-zinc-300 dark:hover:bg-white/10 lg:hidden"
      aria-label="Open category navigation"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>

    <!-- Left: brand logo → root listing -->
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label={`${SITE_NAME} home`}>
      <img
        src="/logo.svg"
        alt={`${SITE_NAME} logo`}
        width="36"
        height="36"
        class="h-9 w-9 drop-shadow-lg drop-shadow-pink-500/25"
      />
      <span class="hidden text-lg font-extrabold tracking-tight md:block">
        DESI<span class="bg-gradient-to-r from-pink-500 to-rose-500 bg-clip-text text-transparent">DUDE</span>
      </span>
    </a>

    <!-- Center: real-time search (live on the catalog, full-page search elsewhere) -->
    <form action="/" method="get" role="search" class="relative mx-auto w-full max-w-xl flex-1">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-zinc-400"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </svg>
      <input
        id="search-input"
        type="search"
        name="q"
        autocomplete="off"
        placeholder="Search titles, tags, categories…  ( / )"
        class="w-full rounded-full border-0 bg-black/5 py-2.5 pl-10 pr-4 text-sm ring-1 ring-black/10 transition placeholder:text-zinc-400 focus:bg-white focus:ring-2 focus:ring-pink-500 dark:bg-white/5 dark:ring-white/10 dark:focus:bg-zinc-900"
        aria-label="Search videos"
      />
    </form>

    <!-- Right: navigation controls -->
    <nav class="flex shrink-0 items-center gap-1.5" aria-label="Primary">
      <button
        id="live-chat-btn"
        type="button"
        class="inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-pink-600 to-rose-500 px-3.5 py-2 text-sm font-semibold text-white shadow-lg shadow-pink-500/25 transition hover:brightness-110 active:translate-y-px"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
          <path d="M21 11.5a8.38 8.38 0 0 1-9 8.4 8.5 8.5 0 0 1-3.4-.8L3 21l1.9-5.6a8.38 8.38 0 0 1-.9-3.9 8.5 8.5 0 0 1 8.5-8.5 8.38 8.38 0 0 1 8.5 8.5Z" />
        </svg>
        <span class="hidden sm:inline">Live chat</span>
      </button>
      <button
        id="theme-toggle"
        type="button"
        class="rounded-lg p-2 text-zinc-600 hover:bg-black/5 dark:text-zinc-300 dark:hover:bg-white/10"
        aria-label="Toggle color theme"
        aria-pressed="true"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="h-5 w-5 dark:hidden"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hidden h-5 w-5 dark:block"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<!-- Live chat popup -->
<div id="live-chat-modal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/60 p-4 backdrop-blur-sm">
  <div class="w-full max-w-sm overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-black/10 dark:bg-zinc-900 dark:ring-white/10">
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-600 to-rose-500 px-5 py-3.5">
      <span class="flex items-center gap-2 font-semibold text-white">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
          <path d="M21 11.5a8.38 8.38 0 0 1-9 8.4 8.5 8.5 0 0 1-3.4-.8L3 21l1.9-5.6a8.38 8.38 0 0 1-.9-3.9 8.5 8.5 0 0 1 8.5-8.5 8.38 8.38 0 0 1 8.5 8.5Z" />
        </svg>
        Live chat
      </span>
      <button
        id="live-chat-close"
        type="button"
        class="rounded-lg p-1.5 text-white/80 transition hover:bg-white/15 hover:text-white"
        aria-label="Close live chat"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-4 w-4" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
    <div class="flex flex-col items-center px-6 py-10 text-center">
      <span class="flex h-14 w-14 items-center justify-center rounded-full bg-pink-100 dark:bg-pink-500/15">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7 text-pink-500" aria-hidden="true">
          <path d="M12 8v4l2.5 2.5" />
          <circle cx="12" cy="12" r="9" />
        </svg>
      </span>
      <p class="mt-4 text-lg font-bold text-zinc-900 dark:text-white">Coming soon</p>
      <p class="mt-1.5 text-sm text-zinc-500 dark:text-zinc-400">
        Our live chat is on its way — stay tuned!
      </p>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var btn = document.getElementById('live-chat-btn');
    var modal = document.getElementById('live-chat-modal');
    if (!btn || !modal) return;
    var close = document.getElementById('live-chat-close');
    function open() {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
    function closeIt() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
    btn.addEventListener('click', open);
    close.addEventListener('click', closeIt);
    modal.addEventListener('click', function (e) {
      if (e.target === modal) closeIt();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeIt();
    });
  })();
</script>
