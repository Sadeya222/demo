---
import type { Video } from '../lib/taxonomy';
import VideoCard from './VideoCard.astro';
import { PER_PAGE } from '../config/site.mjs';

interface Props {
  videos: Video[];
  page: number;
}

const { videos, page } = Astro.props;

const totalPages = Math.max(1, Math.ceil(videos.length / PER_PAGE));
const start = (page - 1) * PER_PAGE;
const pageItems = videos.slice(start, start + PER_PAGE);

/**
 * Client search index — pre-indexed titles, descriptions, categories,
 * subcategories and tags. The header search bar and sidebar tree filter
 * this payload in real time, entirely client-side (no page reloads).
 */
const indexPayload = {
  page,
  perPage: PER_PAGE,
  videos: videos.map((v) => ({
    id: v.id,
    title: v.data.title,
    description: v.data.description,
    thumbnailUrl: v.data.thumbnailUrl,
    duration: v.data.duration,
    publishedAt: v.data.publishedAt.toISOString(),
    category: v.data.category,
    subcategory: v.data.subcategory,
    views: v.data.views,
    tags: v.data.tags,
  })),
};

/** Page-number windowing: 1 … 4 5 6 … 20 */
function pageList(total: number, current: number): (number | '…')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const keep = new Set([1, 2, total - 1, total, current - 1, current, current + 1]);
  const nums = [...keep].filter((p) => p >= 1 && p <= total).sort((a, b) => a - b);
  const out: (number | '…')[] = [];
  let prev = 0;
  for (const p of nums) {
    if (p - prev > 1) out.push('…');
    out.push(p);
    prev = p;
  }
  return out;
}

const pageUrl = (p: number) => (p === 1 ? '/' : `/page/${p}/`);
---

<section aria-label="Video catalog">
  <!-- Toolbar: count + removable active-filter chips (chips are client-rendered) -->
  <div class="mb-5 flex flex-wrap items-center gap-x-3 gap-y-2">
    <h1 class="text-xl font-bold tracking-tight sm:text-2xl">All Videos</h1>
    <span id="vv-count" class="text-sm text-zinc-500 dark:text-zinc-400">
      <span class="font-semibold text-zinc-900 dark:text-zinc-100">{videos.length}</span> videos
    </span>
    <div id="vv-chips" class="flex flex-wrap items-center gap-2"></div>
  </div>

  <noscript>
    <p
      class="mb-4 rounded-xl bg-amber-50 px-4 py-2.5 text-sm text-amber-800 ring-1 ring-amber-200 dark:bg-amber-500/10 dark:text-amber-300 dark:ring-amber-500/30"
    >
      JavaScript is disabled — live search and filtering are off, but the catalog below is fully static.
    </p>
  </noscript>

  <!-- Server-rendered grid (SEO) — JS takes over on first interaction -->
  <div id="vv-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">
    {pageItems.map((video) => <VideoCard video={video} />)}
  </div>

  <!-- Structured pagination: Previous · page numbers · Next -->
  <nav id="vv-pagination" class="mt-8 flex flex-wrap items-center justify-center gap-2" aria-label="Pagination">
    {page > 1
      ? <a href={pageUrl(page - 1)} class="pag">← Prev</a>
      : <span class="pag opacity-40" aria-disabled="true">← Prev</span>}
    {pageList(totalPages, page).map((p) =>
      p === '…'
        ? <span class="px-1 text-zinc-400" aria-hidden="true">…</span>
        : p === page
          ? <span class="pag is-active" aria-current="page">{p}</span>
          : <a href={pageUrl(p)} class="pag">{p}</a>
    )}
    {page < totalPages
      ? <a href={pageUrl(page + 1)} class="pag">Next →</a>
      : <span class="pag opacity-40" aria-disabled="true">Next →</span>}
  </nav>
</section>

<script type="application/json" id="vv-index" set:html={JSON.stringify(indexPayload)}></script>

<script>
  /**
   * Catalog canvas interactivity:
   *  - real-time header search against the pre-indexed JSON payload
   *  - sidebar category/subcategory tree filtering
   *  - client-side pagination while filtering
   *  - shareable state via ?q=&cat=&sub=&page= deep links
   *
   * The initial grid/pagination is server-rendered HTML (SEO + no-JS).
   * JS only replaces it on the first user interaction, or immediately when
   * the page was deep-linked with query params. Clearing everything
   * restores the original server HTML.
   */
  (() => {
    const $ = (id) => document.getElementById(id);
    const grid = $('vv-grid');
    const pag = $('vv-pagination');
    const countEl = $('vv-count');
    const chipsEl = $('vv-chips');
    const searchInput = $('search-input');
    const sidebar = $('sidebar');
    if (!grid || !pag) return;

    const data = JSON.parse($('vv-index').textContent);
    const videos = data.videos;
    const PER = data.perPage;

    const initial = {
      page: data.page,
      pathname: location.pathname,
      gridHTML: grid.innerHTML,
      pagHTML: pag.innerHTML,
      countHTML: countEl.innerHTML,
      chipsHTML: chipsEl.innerHTML,
    };
    const state = { q: '', cat: '', sub: '', page: initial.page };

    const esc = (s) =>
      String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

    /* ── formatting helpers (mirror the server render) ─────────────────── */
    const durLabel = (iso) => {
      const m = String(iso).match(/^PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?$/);
      if (!m) return '';
      const total = (+(m[1] || 0)) * 3600 + (+(m[2] || 0)) * 60 + (+(m[3] || 0));
      const h = Math.floor(total / 3600), mm = Math.floor((total % 3600) / 60), s = total % 60;
      const pad = (n) => String(n).padStart(2, '0');
      return h ? `${h}:${pad(mm)}:${pad(s)}` : `${mm}:${pad(s)}`;
    };
    const dateLabel = (iso) =>
      new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
    const relLabel = (iso) => {
      const diff = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000);
      if (diff < 3600) return 'today';
      if (diff < 86400) return 'yesterday';
      const d = Math.floor(diff / 86400);
      if (d < 7) return d + ' days ago';
      const w = Math.floor(d / 7);
      if (w < 5) return w === 1 ? '1 week ago' : w + ' weeks ago';
      const mo = Math.floor(d / 30);
      if (mo < 12) return mo === 1 ? '1 month ago' : mo + ' months ago';
      const y = Math.floor(d / 365);
      return y === 1 ? '1 year ago' : y + ' years ago';
    };

    /* ── views formatting (mirrors lib/format.ts) ──────────────────────── */
    const viewsLabel = (n) => {
      if (n >= 1000000) {
        const v = n / 1000000;
        return (v >= 10 ? Math.round(v) : Math.round(v * 10) / 10) + 'M views';
      }
      if (n >= 1000) {
        const v = n / 1000;
        return (v >= 10 ? Math.round(v) : Math.round(v * 10) / 10) + 'K views';
      }
      return n + ' views';
    };

    /* ── card renderer (mirrors VideoCard.astro) ───────────────────────── */
    const cardHTML = (v) => `
      <a href="/video/${esc(v.id)}" class="group flex flex-col overflow-hidden rounded-2xl bg-white ring-1 ring-black/10 transition duration-200 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-pink-500/10 dark:bg-zinc-900/60 dark:ring-white/10 dark:hover:ring-pink-500/40">
        <div class="relative aspect-video overflow-hidden bg-zinc-100 dark:bg-zinc-800">
          <img src="${esc(v.thumbnailUrl)}" alt="${esc(v.title)}" loading="lazy" width="640" height="360" class="h-full w-full object-cover transition duration-300 group-hover:scale-105"/>
          <span class="absolute bottom-2 right-2 rounded-md bg-black/80 px-1.5 py-0.5 text-[11px] font-semibold tabular-nums text-white">${esc(durLabel(v.duration))}</span>
        </div>
        <div class="flex flex-1 flex-col p-3.5">
          <h3 class="line-clamp-2 text-sm font-semibold leading-snug text-zinc-900 transition group-hover:text-pink-600 dark:text-zinc-100 dark:group-hover:text-pink-300">${esc(v.title)}</h3>
          <p class="mt-1.5 flex flex-wrap items-center gap-x-1.5 gap-y-0.5 text-xs text-zinc-500 dark:text-zinc-400"><time datetime="${esc(v.publishedAt)}">${esc(dateLabel(v.publishedAt))}</time><span class="opacity-50">·</span>${esc(relLabel(v.publishedAt))}<span class="opacity-50">·</span><span class="inline-flex items-center gap-1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>${esc(viewsLabel(v.views))}</span></p>
          <div class="mt-auto pt-2 text-[11px] font-semibold uppercase tracking-wider text-pink-600/80 dark:text-pink-400/80">${esc(v.category)}</div>
        </div>
      </a>`;

    const emptyHTML = `
      <div class="col-span-full flex flex-col items-center justify-center rounded-2xl border border-dashed border-zinc-300 py-20 text-center dark:border-zinc-700">
        <p class="text-lg font-semibold">No videos found</p>
        <p class="mt-1 text-sm opacity-60">Try a different search, or clear the active filters.</p>
        <button type="button" id="vv-clear-all" class="btn-ghost mt-4">Clear all filters</button>
      </div>`;

    /* ── filtering ─────────────────────────────────────────────────────── */
    const matches = (v) => {
      if (state.cat && v.category !== state.cat) return false;
      if (state.sub && v.subcategory !== state.sub) return false;
      if (state.q) {
        const hay = [v.title, v.description, v.category, v.subcategory, ...v.tags].join(' ').toLowerCase();
        if (!state.q.split(/\s+/).every((t) => hay.includes(t))) return false;
      }
      return true;
    };

    const chipHTML = (key, label) =>
      `<button type="button" data-clear="${key}" class="chip" title="Remove filter">${label}<span class="x" aria-hidden="true">✕</span></button>`;

    const pageList = (total, cur) => {
      if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
      const keep = new Set([1, 2, total - 1, total, cur - 1, cur, cur + 1]);
      const nums = [...keep].filter((p) => p >= 1 && p <= total).sort((a, b) => a - b);
      const out = [];
      let prev = 0;
      for (const p of nums) {
        if (p - prev > 1) out.push('…');
        out.push(p);
        prev = p;
      }
      return out;
    };

    const paginationHTML = (totalPages) => {
      if (totalPages <= 1) return '';
      const btn = (label, target, opts = {}) =>
        `<button type="button" data-goto="${target}" class="pag" ${opts.disabled ? 'disabled' : ''}>${label}</button>`;
      const nums = pageList(totalPages, state.page)
        .map((p) =>
          p === '…' ? '<span class="px-1 text-zinc-400" aria-hidden="true">…</span>' : btn(String(p), p)
        )
        .join('');
      return `<nav class="flex flex-wrap items-center justify-center gap-2" aria-label="Pagination">
        ${btn('← Prev', state.page - 1, { disabled: state.page === 1 })}
        <span class="sr-only">Page ${state.page} of ${totalPages}</span>
        ${nums}
        ${btn('Next →', state.page + 1, { disabled: state.page === totalPages })}
      </nav>`;
    };

    const syncSidebar = () => {
      document.querySelectorAll('[data-filter]').forEach((a) => {
        const c = a.dataset.cat || '';
        const s = a.dataset.sub || '';
        a.classList.toggle('is-active', c === state.cat && s === state.sub);
      });
    };

    const syncSearchInput = () => {
      if (searchInput && searchInput.value !== state.q) searchInput.value = state.q;
    };

    const syncURL = () => {
      const p = new URLSearchParams();
      if (state.q) p.set('q', state.q);
      if (state.cat) p.set('cat', state.cat);
      if (state.sub) p.set('sub', state.sub);
      if (state.page > 1 && p.size) p.set('page', String(state.page));
      const qs = p.toString();
      history.replaceState(null, '', qs ? '/' + '?' + qs : initial.pathname);
    };

    const render = (scroll) => {
      const filtered = videos.filter(matches);
      const totalPages = Math.max(1, Math.ceil(filtered.length / PER));
      state.page = Math.min(Math.max(1, state.page), totalPages);
      const startIdx = (state.page - 1) * PER;
      const items = filtered.slice(startIdx, startIdx + PER);
      grid.innerHTML = items.length ? items.map(cardHTML).join('') : emptyHTML;
      pag.innerHTML = paginationHTML(totalPages);
      countEl.innerHTML = `<span class="font-semibold text-zinc-900 dark:text-zinc-100">${filtered.length}</span> ${filtered.length === 1 ? 'video' : 'videos'}`;
      chipsEl.innerHTML =
        (state.q ? chipHTML('q', `“${esc(state.q)}”`) : '') +
        (state.cat ? chipHTML('cat', esc(state.cat)) : '') +
        (state.sub ? chipHTML('sub', esc(state.sub)) : '');
      syncSidebar();
      syncSearchInput();
      syncURL();
      if (scroll) window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    const hasFilters = () => Boolean(state.q || state.cat || state.sub);

    const resetToServer = () => {
      state.q = '';
      state.cat = '';
      state.sub = '';
      state.page = initial.page;
      grid.innerHTML = initial.gridHTML;
      pag.innerHTML = initial.pagHTML;
      countEl.innerHTML = initial.countHTML;
      chipsEl.innerHTML = initial.chipsHTML;
      syncSidebar();
      syncSearchInput();
      history.replaceState(null, '', initial.pathname);
      closeDrawer();
    };

    const applyFilters = (scroll = true) => {
      if (!hasFilters()) {
        resetToServer();
        return;
      }
      render(scroll);
    };

    /* ── mobile drawer ─────────────────────────────────────────────────── */
    const backdrop = $('sidebar-backdrop');
    const openDrawer = (open) => {
      sidebar?.classList.toggle('-translate-x-full', !open);
      backdrop?.classList.toggle('hidden', !open);
    };
    const closeDrawer = () => {
      if (window.matchMedia('(max-width: 1023px)').matches) openDrawer(false);
    };
    $('menu-btn')?.addEventListener('click', () => openDrawer(true));
    backdrop?.addEventListener('click', () => openDrawer(false));

    /* ── real-time search (debounced 150 ms) ───────────────────────────── */
    let timer;
    searchInput?.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        const q = (searchInput?.value || '').trim();
        if (q === state.q) return;
        state.q = q;
        state.page = 1;
        applyFilters(false);
      }, 150);
    });

    /* ── sidebar taxonomy tree (accordion + filters) ───────────────────── */
    const openGroups = new Set();
    const applyGroupUI = () => {
      document.querySelectorAll('[data-group]').forEach((g) => {
        const open = openGroups.has(g.dataset.group);
        g.classList.toggle('sb-open', open);
        g.querySelector('[data-toggle]')?.setAttribute('aria-expanded', String(open));
        g.querySelector('.chev')?.classList.toggle('open', open);
      });
    };
    document.querySelectorAll('[data-toggle]').forEach((b) =>
      b.addEventListener('click', () => {
        const n = b.dataset.toggle;
        if (openGroups.has(n)) openGroups.delete(n);
        else openGroups.add(n);
        applyGroupUI();
      })
    );
    const openGroupFor = (name) => {
      if (name) {
        openGroups.add(name);
        applyGroupUI();
      }
    };

    document.querySelectorAll('[data-filter]').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        state.cat = a.dataset.cat || '';
        state.sub = a.dataset.sub || '';
        state.page = 1;
        openGroupFor(state.cat);
        applyFilters(true);
        closeDrawer();
      })
    );

    /* ── client pagination + chips + empty state ───────────────────────── */
    pag.addEventListener('click', (e) => {
      const b = e.target.closest('[data-goto]');
      if (!b || b.disabled) return;
      state.page = Math.max(1, +b.dataset.goto);
      render(true);
    });
    chipsEl.addEventListener('click', (e) => {
      const b = e.target.closest('[data-clear]');
      if (!b) return;
      const k = b.dataset.clear;
      if (k === 'q') state.q = '';
      if (k === 'cat') {
        state.cat = '';
        state.sub = '';
      }
      if (k === 'sub') state.sub = '';
      state.page = 1;
      applyFilters(false);
    });
    grid.addEventListener('click', (e) => {
      if (e.target.closest('#vv-clear-all')) resetToServer();
    });

    /* ── keyboard: "/" focuses search ──────────────────────────────────── */
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && !/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName || '')) {
        e.preventDefault();
        searchInput?.focus();
      }
    });

    /* ── deep links: /?q=…&cat=…&sub=…&page=… ──────────────────────────── */
    const params = new URLSearchParams(location.search);
    if (params.has('q') || params.has('cat') || params.has('sub') || params.has('page')) {
      state.q = params.get('q') || '';
      state.cat = params.get('cat') || '';
      state.sub = params.get('sub') || '';
      state.page = Math.max(1, +(params.get('page') || 1));
      openGroupFor(state.cat);
      render(false);
    }
  })();
</script>
