---
interface Props {
  embed: string;
  title: string;
}

const { embed, title } = Astro.props;
---

<!--
  16:9 responsive player — the external embed iframe is rendered directly
  (no click-to-load facade, no site-level play button).
-->
<div
  class="relative aspect-video w-full overflow-hidden rounded-2xl bg-black shadow-2xl shadow-black/30 ring-1 ring-black/20 dark:ring-white/10"
>
  <iframe
    src={embed}
    class="absolute inset-0 h-full w-full"
    title={title}
    scrolling="no"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
    referrerpolicy="no-referrer"
  ></iframe>
</div>
