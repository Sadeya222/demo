---
import type { Video } from '../lib/taxonomy';
import { durationBadge, relativeDate, formatDate } from '../lib/dates';
import { formatViews } from '../lib/format';

interface Props {
  video: Video;
}

const { video } = Astro.props;
---

<a
  href={`/video/${video.id}`}
  class="group flex flex-col overflow-hidden rounded-2xl bg-white ring-1 ring-black/10 transition duration-200 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-pink-500/10 dark:bg-zinc-900/60 dark:ring-white/10 dark:hover:ring-pink-500/40"
>
  <div class="relative aspect-video overflow-hidden bg-zinc-100 dark:bg-zinc-800">
    <img
      src={video.data.thumbnailUrl}
      alt={video.data.title}
      loading="lazy"
      width="640"
      height="360"
      class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
    />
    <!-- Duration badge (bottom-right overlay) -->
    <span
      class="absolute bottom-2 right-2 rounded-md bg-black/80 px-1.5 py-0.5 text-[11px] font-semibold tabular-nums text-white"
    >
      {durationBadge(video.data.duration)}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-3.5">
    <h3
      class="line-clamp-2 text-sm font-semibold leading-snug text-zinc-900 transition group-hover:text-pink-600 dark:text-zinc-100 dark:group-hover:text-pink-300"
    >
      {video.data.title}
    </h3>
    <p class="mt-1.5 flex flex-wrap items-center gap-x-1.5 gap-y-0.5 text-xs text-zinc-500 dark:text-zinc-400">
      <time datetime={video.data.publishedAt.toISOString()}>{formatDate(video.data.publishedAt)}</time>
      <span class="opacity-50">·</span>
      {relativeDate(video.data.publishedAt)}
      <span class="opacity-50">·</span>
      <span class="inline-flex items-center gap-1">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5" aria-hidden="true">
          <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
          <circle cx="12" cy="12" r="3" />
        </svg>
        {formatViews(video.data.views)}
      </span>
    </p>
    <div class="mt-auto pt-2 text-[11px] font-semibold uppercase tracking-wider text-pink-600/80 dark:text-pink-400/80">
      {video.data.category}
    </div>
  </div>
</a>
