---
import { getCollection } from 'astro:content';
import { SITE_NAME, SITE_URL } from '../../config/site.mjs';
import { buildTaxonomy } from '../../lib/taxonomy';
import '../../styles/global.css';

const videos = (await getCollection('videos')).sort(
  (a, b) => +b.data.publishedAt - +a.data.publishedAt
);
const taxonomy = buildTaxonomy(videos);

const data = {
  videos: videos.map((v) => ({ id: v.id, ...v.data, publishedAt: v.data.publishedAt.toISOString() })),
  // category → { total, subs: { sub: count } } — the taxonomy derived from committed JSON
  catCounts: Object.fromEntries(
    taxonomy.map((c) => [c.name, { total: c.count, subs: Object.fromEntries(c.subs.map((s) => [s.name, s.count])) }])
  ),
  stats: {
    videos: videos.length,
    cats: taxonomy.length,
    subs: taxonomy.reduce((a, c) => a + c.subs.length, 0),
    latest: videos[0]?.data.publishedAt.toISOString() ?? '',
  },
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin · {SITE_NAME}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  </head>

  <body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased">
    <!-- Top bar -->
    <header class="sticky top-0 z-40 border-b border-white/10 bg-zinc-950/85 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-6xl items-center gap-2 px-3 sm:gap-3 sm:px-4">
        <a href="/" class="flex min-w-0 shrink-0 items-center gap-2 font-bold tracking-tight text-white">
          <img src="/logo.svg" alt={`${SITE_NAME} logo`} width="28" height="28" class="h-7 w-7" />
          <span class="hidden sm:inline">{SITE_NAME}</span>
          <span class="rounded bg-pink-500/20 px-1.5 py-0.5 text-[10px] font-bold tracking-wider text-pink-300">
            ADMIN
          </span>
        </a>
        <span class="hidden min-w-0 truncate text-xs text-zinc-500 lg:block">
          host: <span class="font-mono text-zinc-300">{SITE_URL}</span>
        </span>
        <span class="ml-auto flex shrink-0 items-center gap-1.5 text-sm sm:gap-2">
          <a href="/" class="btn-ghost whitespace-nowrap">View site ↗</a>
          <a href="/sitemap.xml" class="btn-ghost hidden sm:inline-flex" title="Open the generated sitemap">Sitemap</a>
          <button id="logout" type="button" class="btn-ghost hidden whitespace-nowrap">Sign out</button>
        </span>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-8">
      <!-- ═══════════════════ AUTH GATE ═══════════════════ -->
      <section id="auth-view" class="mx-auto mt-10 max-w-md">
        <div class="card p-8">
          <h1 class="text-lg font-bold">Admin sign in</h1>
          <p class="mt-1.5 text-sm leading-relaxed text-zinc-400">
            Manage the video catalog. The panel prepares your JSON files — publishing happens through Git.
          </p>
          <form id="login-form" class="mt-6 space-y-4">
            <label class="f-label" for="login-user"><span>Username</span>
              <input id="login-user" class="field" autocomplete="username" required />
            </label>
            <label class="f-label" for="login-pass"><span>Password</span>
              <input id="login-pass" type="password" class="field" autocomplete="current-password" required />
            </label>
            <p id="login-error" class="hidden text-sm text-red-400"></p>
            <button type="submit" class="btn-primary w-full">Sign in</button>
          </form>
          <p class="mt-5 text-xs leading-relaxed text-zinc-500">
            Demo gate: user <code class="font-mono text-zinc-300">admin</code> · pass
            <code class="font-mono text-zinc-300">admin</code>. Auth is checked client-side (no backend exists by
            design) — front this route with proxy auth in production.
          </p>
        </div>
      </section>

      <!-- ═══════════════════ DASHBOARD ═══════════════════ -->
      <section id="dash-view" class="hidden">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <h1 class="text-xl font-bold tracking-tight">Catalog manager</h1>
            <p class="mt-1 text-sm text-zinc-400">
              Every video below is a JSON file in <code class="font-mono text-xs">src/content/videos/</code>.
            </p>
          </div>
          <div class="text-right text-xs text-zinc-500">
            Data source: <span class="font-mono text-zinc-300">GitHub repo → JSON</span> (zero database)
          </div>
        </div>

        <!-- Stats -->
        <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
          <div class="card p-4">
            <div class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Videos</div>
            <div id="stat-videos" class="mt-1 text-2xl font-bold"></div>
          </div>
          <div class="card p-4">
            <div class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Categories</div>
            <div id="stat-cats" class="mt-1 text-2xl font-bold"></div>
          </div>
          <div class="card p-4">
            <div class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Subcategories</div>
            <div id="stat-subs" class="mt-1 text-2xl font-bold"></div>
          </div>
          <div class="card p-4">
            <div class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Latest publish</div>
            <div id="stat-latest" class="mt-1 text-lg font-bold"></div>
          </div>
        </div>

        <div class="mt-8 grid gap-6 lg:grid-cols-2">
          <!-- JSON builder -->
          <form id="builder" class="card" novalidate>
            <div class="flex items-center justify-between gap-3">
              <h2 class="font-bold">Video JSON builder</h2>
              <span id="mode-badge" class="rounded-full bg-white/5 px-2.5 py-1 text-[11px] font-semibold text-zinc-400">
                NEW ENTRY
              </span>
            </div>
            <p id="mode-note" class="mt-1 text-xs text-zinc-500">
              Fill in the fields — the JSON preview updates live. Then save it into the repo via Git.
            </p>

            <div class="mt-5">
              <label class="f-label" for="f-id">
                <span>Video ID <em class="font-normal normal-case text-zinc-500">(filename → /video/&lt;id&gt;)</em></span>
                <input id="f-id" class="field font-mono" placeholder="my-amazing-video" autocomplete="off" spellcheck="false" />
              </label>

              <label class="f-label" for="f-title">
                <span>Title <span id="count-title" class="float-right font-normal normal-case text-zinc-500">0/70</span></span>
                <input id="f-title" class="field" maxlength="70" placeholder="Concise, search-friendly title" />
              </label>

              <label class="f-label" for="f-desc">
                <span>Description <span id="count-desc" class="float-right font-normal normal-case text-zinc-500">0/160</span></span>
                <textarea id="f-desc" class="field" rows="3" maxlength="160" placeholder="Snippet-optimized summary (max 160 chars)"></textarea>
              </label>

              <label class="f-label" for="f-embed">
                <span>Embed URL <em class="font-normal normal-case text-zinc-500">(iframe src — external player)</em></span>
                <input id="f-embed" class="field font-mono text-xs" placeholder="https://player.example.com/embed/…" />
              </label>

              <label class="f-label" for="f-thumb">
                <span>Thumbnail URL <em class="font-normal normal-case text-zinc-500">(external image)</em></span>
                <input id="f-thumb" class="field font-mono text-xs" placeholder="https://images.example.com/thumb.jpg" />
              </label>

              <div class="grid grid-cols-3 gap-3">
                <label class="f-label" for="f-dh"><span>Hours</span><input id="f-dh" type="number" min="0" max="9" value="0" class="field" /></label>
                <label class="f-label" for="f-dm"><span>Minutes</span><input id="f-dm" type="number" min="0" max="59" value="8" class="field" /></label>
                <label class="f-label" for="f-ds"><span>Seconds</span><input id="f-ds" type="number" min="0" max="59" value="45" class="field" /></label>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <label class="f-label" for="f-date"><span>Publish date</span><input id="f-date" type="date" class="field" /></label>
                <label class="f-label" for="f-views"><span>Views <em class="font-normal normal-case text-zinc-500">(real count)</em></span><input id="f-views" type="number" min="0" step="1" value="0" class="field" placeholder="12000" /></label>
              </div>
              <label class="f-label" for="f-cat">
                <span>Main category</span>
                <input id="f-cat" class="field" list="cat-list" placeholder="Tech" />
                <datalist id="cat-list"></datalist>
              </label>

              <label class="f-label" for="f-sub">
                <span>Subcategory <em class="font-normal normal-case text-zinc-500">(options follow the selected category)</em></span>
                <input id="f-sub" class="field" list="sub-list" placeholder="Web Development" />
                <datalist id="sub-list"></datalist>
              </label>

              <label class="f-label" for="f-tags">
                <span>Tags <em class="font-normal normal-case text-zinc-500">(comma separated — powers related videos)</em></span>
                <input id="f-tags" class="field" placeholder="astro, frontend, tutorial" />
              </label>
            </div>

            <div class="mt-4 flex flex-wrap gap-2">
              <button type="button" id="copy-json" class="btn-primary">Copy JSON</button>
              <button type="button" id="download-json" class="btn-ghost">Download .json</button>
              <button type="button" id="reset-form" class="btn-ghost">Reset</button>
            </div>
          </form>

          <!-- Live preview + Git workflow -->
          <div class="space-y-6">
            <div class="card">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-sm font-bold">
                  Preview → <span class="font-mono text-pink-300">src/content/videos/<span id="file-name">&lt;id&gt;.json</span></span>
                </h3>
                <span id="valid-badge" class="rounded-full px-2.5 py-1 text-[11px] font-semibold"></span>
              </div>
              <pre id="json-out" class="json-out mt-3"></pre>
              <ul id="valid-errors" class="mt-3 list-disc space-y-1 pl-5 text-xs text-red-400"></ul>
            </div>

            <div class="card text-sm">
              <h3 class="font-bold">Ship it with Git</h3>
              <ol class="mt-3 list-decimal space-y-2 pl-5 text-zinc-400">
                <li>
                  Save the JSON above as
                  <code id="git-path" class="font-mono text-xs text-pink-300">src/content/videos/&lt;id&gt;.json</code>
                </li>
                <li><code class="font-mono text-xs">git add src/content/videos/&lt;id&gt;.json</code></li>
                <li><code class="font-mono text-xs">git commit -m "<span id="git-msg">Add video: &lt;id&gt;</span>"</code></li>
                <li><code class="font-mono text-xs">git push</code> → rebuild · catalog, sidebar, search index, sitemap & schema update automatically</li>
              </ol>
              <p class="mt-3 rounded-lg bg-white/5 p-3 text-xs leading-relaxed text-zinc-500">
                The build schema validates every field (title ≤ 70, description ≤ 160, ISO 8601 duration & date,
                valid URLs, ≥ 1 tag). A broken commit fails the build — the site never serves bad data.
              </p>
            </div>
          </div>
        </div>

        <!-- ═══════════ TAXONOMY MANAGER ═══════════ -->
        <div class="card mt-6">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 class="font-bold">Categories & subcategories</h3>
            <span class="text-xs text-zinc-500">Create new categories, then nest subcategories under the selected category</span>
          </div>

          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            <div class="rounded-xl bg-white/5 p-3">
              <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-zinc-400">Add category</p>
              <div class="flex gap-2">
                <input id="tax-cat-input" class="field" list="cat-list" placeholder="e.g. Music" />
                <button type="button" id="tax-add-cat" class="btn-ghost whitespace-nowrap">+ Add</button>
              </div>
            </div>
            <div class="rounded-xl bg-white/5 p-3">
              <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-zinc-400">Add subcategory to selected category</p>
              <div class="flex flex-wrap gap-2">
                <select id="tax-sub-cat" class="field !w-auto"></select>
                <input id="tax-sub-input" class="field min-w-[10rem] flex-1" placeholder="e.g. Tutorials" />
                <button type="button" id="tax-add-sub" class="btn-ghost whitespace-nowrap">+ Add</button>
              </div>
            </div>
          </div>

          <div id="tax-list" class="mt-4"></div>

          <p class="mt-4 rounded-lg bg-white/5 p-3 text-xs leading-relaxed text-zinc-500">
            <strong class="text-zinc-300">How it works (zero-database):</strong> the public taxonomy is derived from
            committed JSON files. <span class="text-emerald-300">LIVE</span> = already used by committed videos (shown
            in the site sidebar). <span class="text-amber-300">DRAFT</span> = created here (saved in this browser) —
            it goes live the moment you publish a video that uses it via Git. Drafts can be deleted freely;
            live items disappear only when their videos are updated or removed.
          </p>
        </div>

        <!-- ═══════════ SEO ENGINE ═══════════ -->
        <div class="card mt-6">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 class="font-bold">SEO engine — live output</h3>
            <div class="flex items-center gap-2">
              <select id="seo-vid" class="field !w-auto !py-1.5 text-xs"></select>
              <button type="button" id="seo-verify" class="btn-ghost" title="Fetch the live files from the running site and verify they match the collection">Verify live file</button>
              <button type="button" id="seo-copy" class="btn-ghost">Copy</button>
            </div>
          </div>

          <div class="mt-3 flex flex-wrap gap-1.5">
            <button type="button" data-seo-tab="sitemap" class="seo-tab is-active">sitemap.xml</button>
            <button type="button" data-seo-tab="robots" class="seo-tab">robots.txt</button>
            <button type="button" data-seo-tab="jsonld" class="seo-tab">VideoObject JSON-LD (schema.org)</button>
          </div>

          <pre id="seo-out" class="json-out mt-3"></pre>
          <p id="seo-status" class="mt-2 text-xs"></p>
          <p class="mt-2 text-xs leading-relaxed text-zinc-500">
            Generated from the JSON collection — the production <code class="font-mono">/sitemap.xml</code>,
            <code class="font-mono">/robots.txt</code> and the <code class="font-mono">VideoObject</code> JSON-LD in
            every video page's <code class="head">&lt;head&gt;</code> are built from this same data at build time
            (using <code class="font-mono">SITE_URL</code> from <code class="font-mono">src/config/site.mjs</code>).
            The previews above are rendered live with the current host so you can verify the exact output.
          </p>
        </div>

        <!-- Catalog table -->
        <div class="card mt-6 overflow-x-auto p-0">
          <div class="flex flex-wrap items-center justify-between gap-2 px-5 pt-5">
            <h3 class="font-bold">Current catalog <span id="catalog-count" class="text-sm font-normal text-zinc-500"></span></h3>
            <p class="text-xs text-zinc-500">Edit loads a video into the builder above · Delete gives you the exact Git command</p>
          </div>
          <table class="mt-3 w-full min-w-[46rem] text-left text-sm">
            <thead>
              <tr class="border-b border-white/10 text-[11px] uppercase tracking-wider text-zinc-500">
                <th class="px-5 py-3 font-semibold">ID</th>
                <th class="px-3 py-3 font-semibold">Title</th>
                <th class="px-3 py-3 font-semibold">Taxonomy</th>
                <th class="px-3 py-3 font-semibold">Published</th>
                <th class="px-3 py-3 font-semibold">Duration</th>
                <th class="px-3 py-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="catalog-body"></tbody>
          </table>
        </div>
      </section>
    </main>

    <footer class="border-t border-white/10 px-4 py-5 text-center text-xs text-zinc-600">
      {SITE_NAME} admin · zero-database by design — the Git repository is the system of record.
    </footer>

    <!-- Delete confirmation modal -->
    <div id="del-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4 backdrop-blur-sm">
      <div class="card w-full max-w-md p-6">
        <h3 class="text-lg font-bold">Delete video</h3>
        <p id="del-desc" class="mt-2 text-sm text-zinc-400"></p>
        <pre id="del-cmd" class="json-out mt-4 !max-h-none !text-xs"></pre>
        <p class="mt-2 text-xs text-zinc-500">
          Run these commands in the repository, push, and the site rebuilds without the video — catalog,
          sidebar counters, search index, sitemap and schema all update automatically.
        </p>
        <div class="mt-4 flex gap-2">
          <button type="button" id="del-copy" class="btn-primary">Copy git commands</button>
          <button type="button" id="del-close" class="btn-ghost">Close</button>
        </div>
      </div>
    </div>

    <script type="application/json" id="admin-data" set:html={JSON.stringify(data)}></script>

    <script>
      const $ = (id) => document.getElementById(id);
      const esc = (s) =>
        String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
      const data = JSON.parse($('admin-data').textContent);
      const AUTH_KEY = 'vv-admin-session';
      const TAX_KEY = 'vv-taxonomy-drafts';

      /* ══ Auth (demo gate — admin / admin) ══════════════════════════════ */
      function showAuth() {
        $('auth-view').classList.remove('hidden');
        $('dash-view').classList.add('hidden');
        $('logout').classList.add('hidden');
      }
      function showDash() {
        $('auth-view').classList.add('hidden');
        $('dash-view').classList.remove('hidden');
        $('logout').classList.remove('hidden');
      }
      $('login-form').addEventListener('submit', (e) => {
        e.preventDefault();
        if ($('login-user').value.trim() === 'admin' && $('login-pass').value === 'admin') {
          sessionStorage.setItem(AUTH_KEY, '1');
          $('login-error').classList.add('hidden');
          showDash();
        } else {
          const el = $('login-error');
          el.textContent = 'Invalid credentials. Hint: admin / admin';
          el.classList.remove('hidden');
        }
      });
      $('logout').addEventListener('click', () => {
        sessionStorage.removeItem(AUTH_KEY);
        showAuth();
      });

      /* ══ Duration helpers ══════════════════════════════════════════════ */
      function durSecs(iso) {
        const m = String(iso).match(/^PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?$/);
        return m ? (+(m[1] || 0)) * 3600 + (+(m[2] || 0)) * 60 + (+(m[3] || 0)) : 0;
      }
      function durLabel(iso) {
        const t = durSecs(iso);
        const h = Math.floor(t / 3600), m = Math.floor((t % 3600) / 60), s = t % 60;
        const pad = (n) => String(n).padStart(2, '0');
        return h ? `${h}:${pad(m)}:${pad(s)}` : `${m}:${pad(s)}`;
      }

      /* ══ Stats ═════════════════════════════════════════════════════════ */
      $('stat-videos').textContent = data.stats.videos;
      $('stat-cats').textContent = data.stats.cats;
      $('stat-subs').textContent = data.stats.subs;
      $('stat-latest').textContent = data.stats.latest
        ? new Date(data.stats.latest).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
        : '—';

      /* ══ Taxonomy manager (categories + subcategories) ═════════════════ */
      // Drafts live in this browser (zero-database: the committed JSON is
      // the source of truth — drafts go live when a video using them is pushed).
      let extra = {}; // { cat: [sub, ...] }
      try {
        extra = JSON.parse(localStorage.getItem(TAX_KEY) || '{}');
      } catch {
        extra = {};
      }
      const saveExtra = () => {
        try {
          localStorage.setItem(TAX_KEY, JSON.stringify(extra));
        } catch {}
      };

      const derived = data.catCounts;
      const mergedCats = () => {
        const cats = new Set([...Object.keys(derived), ...Object.keys(extra)]);
        return [...cats].sort(
          (a, b) => (derived[b] ? derived[b].total : 0) - (derived[a] ? derived[a].total : 0) || a.localeCompare(b)
        );
      };
      const mergedSubs = (cat) => {
        const d = derived[cat] ? derived[cat].subs : {};
        const e = extra[cat] || [];
        return [...new Set([...Object.keys(d), ...e])].map((name) => ({
          name,
          count: d[name] ?? 0,
          draft: !(name in d),
        }));
      };

      function renderTaxonomy() {
        const cats = mergedCats();
        $('tax-list').innerHTML = cats
          .map((cat) => {
            const d = derived[cat];
            const live = !!d && d.total > 0;
            const subs = mergedSubs(cat);
            return `
        <div class="border-b border-white/5 py-3 last:border-0">
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-semibold">${esc(cat)}</span>
            <span class="rounded-full bg-white/10 px-2 py-0.5 text-[11px] font-semibold tabular-nums text-zinc-300">${d ? d.total : 0} videos</span>
            <span class="${live ? 'rounded-full bg-emerald-500/15 px-2 py-0.5 text-[10px] font-bold text-emerald-300' : 'rounded-full bg-amber-500/15 px-2 py-0.5 text-[10px] font-bold text-amber-300'}">${live ? 'LIVE' : 'DRAFT'}</span>
            ${live ? '' : `<button type="button" data-del-cat="${esc(cat)}" class="ml-auto rounded-md px-2 py-1 text-xs text-zinc-500 transition hover:bg-red-500/10 hover:text-red-400">Delete category</button>`}
          </div>
          <div class="mt-2 flex flex-wrap gap-2 pl-4">
            ${subs
              .map(
                (s) => `
              <span class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-xs text-zinc-300">
                ${esc(s.name)}
                <span class="tabular-nums text-zinc-500">${s.count}</span>
                ${s.draft ? '<em class="text-[9px] font-bold uppercase tracking-wider not-italic text-amber-300">draft</em>' : ''}
                ${s.draft ? `<button type="button" data-del-sub-cat="${esc(cat)}" data-del-sub="${esc(s.name)}" title="Delete draft subcategory" class="text-zinc-500 transition hover:text-red-400">✕</button>` : ''}
              </span>`
              )
              .join('')}
            ${subs.length === 0 ? '<span class="text-xs text-zinc-600">No subcategories yet — add one above.</span>' : ''}
          </div>
        </div>`;
          })
          .join('');
        // feed the builder + add-sub picklists
        $('cat-list').innerHTML = cats.map((c) => `<option value="${esc(c)}">`).join('');
        $('tax-sub-cat').innerHTML = cats.map((c) => `<option value="${esc(c)}">${esc(c)}${derived[c] ? '' : ' (draft)'}</option>`).join('');
        refreshSubList();
      }

      function refreshSubList() {
        const cat = $('f-cat').value.trim();
        const subs = cat ? mergedSubs(cat).map((s) => s.name) : [];
        $('sub-list').innerHTML = subs.map((s) => `<option value="${esc(s)}">`).join('');
      }

      $('tax-add-cat').addEventListener('click', () => {
        const cat = $('tax-cat-input').value.trim();
        if (!cat) return;
        if (!extra[cat]) extra[cat] = [];
        saveExtra();
        $('tax-cat-input').value = '';
        $('tax-sub-cat').value = cat;
        renderTaxonomy();
      });
      $('tax-add-sub').addEventListener('click', () => {
        const cat = $('tax-sub-cat').value;
        const sub = $('tax-sub-input').value.trim();
        if (!cat || !sub) return;
        if (!extra[cat]) extra[cat] = [];
        if (!extra[cat].includes(sub)) extra[cat].push(sub);
        saveExtra();
        $('tax-sub-input').value = '';
        renderTaxonomy();
      });
      $('tax-list').addEventListener('click', (e) => {
        const delCat = e.target.closest('[data-del-cat]');
        if (delCat) {
          const cat = delCat.dataset.delCat;
          if (!confirm(`Delete draft category "${cat}"? (Only unused/draft categories can be deleted here.)`)) return;
          delete extra[cat];
          saveExtra();
          renderTaxonomy();
          return;
        }
        const delSub = e.target.closest('[data-del-sub]');
        if (delSub) {
          const cat = delSub.dataset.delSubCat;
          const sub = delSub.dataset.delSub;
          extra[cat] = (extra[cat] || []).filter((s) => s !== sub);
          if (!extra[cat].length) delete extra[cat];
          saveExtra();
          renderTaxonomy();
        }
      });

      /* ══ SEO engine (live sitemap / robots / JSON-LD) ══════════════════ */
      function liveSitemap() {
        const o = location.origin;
        const today = new Date().toISOString().slice(0, 10);
        const entries = [
          `  <url>\n    <loc>${o}/</loc>\n    <lastmod>${today}</lastmod>\n    <changefreq>daily</changefreq>\n    <priority>1.0</priority>\n  </url>`,
          ...data.videos.map(
            (v) =>
              `  <url>\n    <loc>${o}/video/${esc(v.id)}</loc>\n    <lastmod>${v.publishedAt.slice(0, 10)}</lastmod>\n    <changefreq>monthly</changefreq>\n    <priority>0.8</priority>\n  </url>`
          ),
        ];
        return `<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n${entries.join('\n')}\n</urlset>\n`;
      }
      function liveRobots() {
        return `User-agent: *\nAllow: /\nDisallow: /admin\n\nSitemap: ${location.origin}/sitemap.xml\n`;
      }
      function videoJsonLd(v) {
        return {
          '@context': 'https://schema.org',
          '@type': 'VideoObject',
          name: v.title,
          description: v.description,
          thumbnailUrl: [v.thumbnailUrl],
          uploadDate: v.publishedAt,
          duration: v.duration,
          embedUrl: v.embedUrl,
          contentUrl: v.embedUrl,
          genre: v.category,
          keywords: v.tags.join(', '),
        };
      }

      let seoTab = 'sitemap';
      let seoContent = '';
      function renderSeo() {
        const v = data.videos.find((x) => x.id === $('seo-vid').value) || data.videos[0];
        if (seoTab === 'sitemap') seoContent = liveSitemap();
        if (seoTab === 'robots') seoContent = liveRobots();
        if (seoTab === 'jsonld') seoContent = JSON.stringify(videoJsonLd(v), null, 2);
        $('seo-out').textContent = seoContent;
        $('seo-vid').disabled = seoTab !== 'jsonld';
        $('seo-vid').title = seoTab === 'jsonld' ? 'Pick a video to inspect its schema.org markup' : 'Used by the VideoObject JSON-LD tab';
      }
      document.querySelectorAll('[data-seo-tab]').forEach((b) =>
        b.addEventListener('click', () => {
          seoTab = b.dataset.seoTab;
          document.querySelectorAll('[data-seo-tab]').forEach((x) => x.classList.toggle('is-active', x === b));
          renderSeo();
        })
      );
      $('seo-copy').addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(seoContent);
          flash($('seo-copy'), 'Copied ✓');
        } catch {}
      });

      /* Live verification: fetch the real /sitemap.xml or /robots.txt from the
         running site and confirm it matches the current JSON collection. */
      function seoStatus(ok, text) {
        const el = $('seo-status');
        el.textContent = (ok ? '✓ ' : '✕ ') + text;
        el.className = 'mt-2 text-xs font-medium ' + (ok ? 'text-emerald-300' : 'text-red-300');
      }
      $('seo-verify').addEventListener('click', async () => {
        try {
          if (seoTab === 'robots') {
            const r = await fetch('/robots.txt', { cache: 'no-store' });
            const t = await r.text();
            const ok = r.ok && /Sitemap:\s*\S+\/sitemap\.xml/.test(t);
            seoStatus(
              ok,
              ok
                ? `/robots.txt is live — crawl rules + Sitemap declaration present (${t.trim().split('\n').length} lines).`
                : `/robots.txt is missing its Sitemap declaration.`
            );
            return;
          }
          const r = await fetch('/sitemap.xml', { cache: 'no-store' });
          const t = await r.text();
          const urls = (t.match(/<loc>/g) || []).length;
          const expect = data.videos.length + 1; // home + every video
          const allPresent = data.videos.every((v) => t.includes(`/video/${v.id}`));
          const ok = r.ok && urls === expect && allPresent;
          seoStatus(
            ok,
            ok
              ? `Dynamic sitemap verified — /sitemap.xml is live with ${urls} URLs (home + ${data.videos.length} videos); every entry in the JSON collection is indexed. It regenerates automatically on every build.`
              : `Mismatch — found ${urls} URLs, expected ${expect}; all video routes present: ${allPresent}.`
          );
        } catch (e) {
          seoStatus(false, 'Could not fetch the live file from the running site.');
        }
      });

      /* ══ Catalog table (edit + delete) ═════════════════════════════════ */
      $('catalog-count').textContent = `(${data.videos.length} entries)`;
      $('catalog-body').innerHTML = data.videos
        .map(
          (v) => `
        <tr class="border-t border-white/5 transition hover:bg-white/[0.03]">
          <td class="whitespace-nowrap px-5 py-3 font-mono text-xs text-pink-300">${esc(v.id)}</td>
          <td class="max-w-[14rem] truncate px-3 py-3" title="${esc(v.title)}">${esc(v.title)}</td>
          <td class="whitespace-nowrap px-3 py-3 text-xs text-zinc-400">${esc(v.category)} › ${esc(v.subcategory)}</td>
          <td class="whitespace-nowrap px-3 py-3 text-xs tabular-nums text-zinc-400">${v.publishedAt.slice(0, 10)}</td>
          <td class="whitespace-nowrap px-3 py-3 text-xs tabular-nums text-zinc-400">${esc(durLabel(v.duration))}</td>
          <td class="whitespace-nowrap px-3 py-3 text-right">
            <button type="button" data-edit="${esc(v.id)}" class="btn-ghost">Edit</button>
            <button type="button" data-del="${esc(v.id)}" class="btn-ghost !text-red-300 hover:!bg-red-500/10">Delete</button>
          </td>
        </tr>`
        )
        .join('');

      $('catalog-body').addEventListener('click', (e) => {
        const edit = e.target.closest('[data-edit]');
        if (edit) {
          const v = data.videos.find((x) => x.id === edit.dataset.edit);
          if (v) {
            loadVideo(v);
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
          return;
        }
        const del = e.target.closest('[data-del]');
        if (del) openDeleteModal(del.dataset.del);
      });

      /* ══ Delete modal (Git workflow) ═══════════════════════════════════ */
      let delTarget = null;
      function openDeleteModal(id) {
        delTarget = id;
        const v = data.videos.find((x) => x.id === id);
        $('del-desc').innerHTML = `This removes <code class="font-mono text-pink-300">${esc(id)}.json</code>
          <span class="text-zinc-500">— “${esc(v ? v.title : '')}”</span> from the repository. The static site cannot delete
          files by itself, so run the Git commands below, push, and let the rebuild clean the catalog,
          sitemap, search index and schema automatically.`;
        $('del-cmd').textContent =
          `git rm src/content/videos/${id}.json\n` +
          `git commit -m "Remove video: ${id}"\n` +
          `git push`;
        const m = $('del-modal');
        m.classList.remove('hidden');
        m.classList.add('flex');
      }
      function closeDeleteModal() {
        const m = $('del-modal');
        m.classList.add('hidden');
        m.classList.remove('flex');
      }
      $('del-close').addEventListener('click', closeDeleteModal);
      $('del-modal').addEventListener('click', (e) => {
        if (e.target === $('del-modal')) closeDeleteModal();
      });
      $('del-copy').addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText($('del-cmd').textContent);
          flash($('del-copy'), 'Copied ✓');
        } catch {}
      });

      /* ══ Builder ═══════════════════════════════════════════════════════ */
      const idInput = $('f-id');
      let idTouched = false;

      function slugify(s) {
        return String(s).toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
      }

      function setMode(id) {
        const badge = $('mode-badge');
        const copyBtn = $('copy-json');
        if (id) {
          badge.textContent = 'EDITING';
          badge.className = 'rounded-full bg-amber-500/15 px-2.5 py-1 text-[11px] font-semibold text-amber-300';
          $('mode-note').textContent = `Editing ${id}.json — changes replace the existing values. Copy or download the updated JSON and overwrite the file, then commit.`;
          $('git-msg').textContent = `Update video: ${id}`;
          copyBtn.textContent = 'Copy updated JSON';
        } else {
          badge.textContent = 'NEW ENTRY';
          badge.className = 'rounded-full bg-white/5 px-2.5 py-1 text-[11px] font-semibold text-zinc-400';
          $('mode-note').textContent = 'Fill in the fields — the JSON preview updates live. Then save it into the repo via Git.';
          $('git-msg').textContent = 'Add video: <id>';
          copyBtn.textContent = 'Copy JSON';
        }
      }

      function countChars() {
        $('count-title').textContent = `${$('f-title').value.length}/70`;
        $('count-desc').textContent = `${$('f-desc').value.length}/160`;
      }

      $('f-title').addEventListener('input', () => {
        if (!idTouched) idInput.value = slugify($('f-title').value);
        countChars();
        updatePreview();
      });
      idInput.addEventListener('input', () => {
        idInput.value = slugify(idInput.value);
        idTouched = idInput.value.length > 0;
        updatePreview();
      });
      $('f-cat').addEventListener('input', refreshSubList);

      function readForm() {
        const h = Math.max(0, +($('f-dh').value || 0));
        const m = Math.max(0, +($('f-dm').value || 0));
        const s = Math.max(0, +($('f-ds').value || 0));
        let dur = '';
        if (h || m || s) {
          dur = 'PT';
          if (h) dur += h + 'H';
          if (m) dur += m + 'M';
          if (s || (!h && !m)) dur += s + 'S';
        }
        const date = $('f-date').value;
        return {
          title: $('f-title').value.trim(),
          description: $('f-desc').value.trim(),
          embedUrl: $('f-embed').value.trim(),
          thumbnailUrl: $('f-thumb').value.trim(),
          duration: dur,
          publishedAt: date ? new Date(date + 'T12:00:00Z').toISOString() : '',
          category: $('f-cat').value.trim(),
          subcategory: $('f-sub').value.trim(),
          views: Math.max(0, Math.floor(+($('f-views').value || 0))),
          tags: $('f-tags').value.split(',').map((t) => t.trim().toLowerCase()).filter(Boolean),
        };
      }

      function validate(o) {
        const errs = [];
        if (!/^[a-z0-9-]{3,60}$/.test(idInput.value)) errs.push('ID: 3–60 chars, lowercase letters/numbers/dashes.');
        if (o.title.length < 3 || o.title.length > 70) errs.push('Title must be 3–70 characters.');
        if (o.description.length < 10 || o.description.length > 160) errs.push('Description must be 10–160 characters.');
        if (!/^https?:\/\/\S+$/i.test(o.embedUrl)) errs.push('Embed URL must be a valid http(s) URL.');
        if (!/^https?:\/\/\S+$/i.test(o.thumbnailUrl)) errs.push('Thumbnail URL must be a valid http(s) URL.');
        if (!o.duration) errs.push('Duration must be greater than 0.');
        if (!o.publishedAt) errs.push('Publication date is required.');
        if (!o.category) errs.push('Main category is required.');
        if (!o.subcategory) errs.push('Subcategory is required.');
        if (!o.tags.length) errs.push('Add at least one tag.');
        return errs;
      }

      function updatePreview() {
        const o = readForm();
        const errs = validate(o);
        $('json-out').textContent = JSON.stringify(o, null, 2);
        const name = idInput.value ? `${idInput.value}.json` : '<id>.json';
        $('file-name').textContent = name;
        $('git-path').textContent = `src/content/videos/${name}`;
        const badge = $('valid-badge');
        if (errs.length) {
          badge.textContent = `✕ ${errs.length} issue${errs.length === 1 ? '' : 's'}`;
          badge.className = 'rounded-full bg-red-500/15 px-2.5 py-1 text-[11px] font-semibold text-red-300';
        } else {
          badge.textContent = '✓ Valid — matches build schema';
          badge.className = 'rounded-full bg-emerald-500/15 px-2.5 py-1 text-[11px] font-semibold text-emerald-300';
        }
        $('valid-errors').innerHTML = errs.map((e) => `<li>${esc(e)}</li>`).join('');
      }

      $('builder').addEventListener('input', () => {
        countChars();
        updatePreview();
      });

      function loadVideo(v) {
        setMode(v.id);
        $('f-title').value = v.title;
        $('f-desc').value = v.description;
        $('f-embed').value = v.embedUrl;
        $('f-thumb').value = v.thumbnailUrl;
        idInput.value = v.id;
        idTouched = true;
        const t = durSecs(v.duration);
        $('f-dh').value = Math.floor(t / 3600);
        $('f-dm').value = Math.floor((t % 3600) / 60);
        $('f-ds').value = t % 60;
        $('f-date').value = v.publishedAt.slice(0, 10);
        $('f-views').value = v.views ?? 0;
        $('f-cat').value = v.category;
        $('f-sub').value = v.subcategory;
        $('f-tags').value = v.tags.join(', ');
        refreshSubList();
        countChars();
        updatePreview();
      }

      /* ══ Defaults (demo seed URLs pre-filled) ══════════════════════════ */
      $('f-date').value = new Date().toISOString().slice(0, 10);
      $('f-embed').value = 'https://luluvdo.com/e/h2a4h636uv6u';
      $('f-thumb').value =
        'https://i.postimg.cc/p5bbqJ8Q/363429454-106817469166168-8969862643825409573-n.jpg';
      countChars();

      /* ══ Copy / Download / Reset ═══════════════════════════════════════ */
      function flash(btn, msg) {
        const old = btn.textContent;
        btn.textContent = msg;
        setTimeout(() => {
          btn.textContent = old;
        }, 1500);
      }

      $('copy-json').addEventListener('click', async () => {
        const text = $('json-out').textContent;
        try {
          await navigator.clipboard.writeText(text);
          flash($('copy-json'), 'Copied ✓');
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
          flash($('copy-json'), 'Copied ✓');
        }
      });

      $('download-json').addEventListener('click', () => {
        const blob = new Blob([JSON.stringify(readForm(), null, 2)], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `${idInput.value || 'video'}.json`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(a.href);
        flash($('download-json'), 'Saved ✓');
      });

      $('reset-form').addEventListener('click', () => {
        setMode(null);
        $('f-title').value = '';
        $('f-desc').value = '';
        $('f-embed').value = 'https://luluvdo.com/e/h2a4h636uv6u';
        $('f-thumb').value =
          'https://i.postimg.cc/p5bbqJ8Q/363429454-106817469166168-8969862643825409573-n.jpg';
        idInput.value = '';
        idTouched = false;
        $('f-dh').value = 0;
        $('f-dm').value = 8;
        $('f-ds').value = 45;
        $('f-date').value = new Date().toISOString().slice(0, 10);
        $('f-views').value = 0;
        $('f-cat').value = '';
        $('f-sub').value = '';
        $('f-tags').value = '';
        refreshSubList();
        countChars();
        updatePreview();
      });

      /* ══ Init ══════════════════════════════════════════════════════════ */
      $('seo-vid').innerHTML = data.videos.map((v) => `<option value="${esc(v.id)}">${esc(v.id)}</option>`).join('');
      $('seo-vid').addEventListener('change', renderSeo);
      renderTaxonomy();
      updatePreview();
      renderSeo();

      if (sessionStorage.getItem(AUTH_KEY) === '1') showDash();
    </script>

    <style>
      .seo-tab {
        border-radius: 0.6rem;
        padding: 0.4rem 0.9rem;
        font-size: 0.78rem;
        font-weight: 600;
        border: 1px solid rgb(255 255 255 / 0.12);
        color: #a1a1aa;
        background: transparent;
        cursor: pointer;
        transition: all 0.15s ease;
      }
      .seo-tab:hover {
        color: #e4e4e7;
      }
      .seo-tab.is-active {
        background: #db2777;
        border-color: #db2777;
        color: #fff;
      }
      select.field {
        appearance: auto;
      }
      select.field option {
        background: #18181b;
        color: #fff;
      }
    </style>
  </body>
</html>
