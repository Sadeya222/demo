---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import CatalogCanvas from '../../components/CatalogCanvas.astro';
import { PER_PAGE } from '../../config/site.mjs';

export async function getStaticPaths() {
  const all = (await getCollection('videos')).sort(
    (a, b) => +b.data.publishedAt - +a.data.publishedAt
  );
  const totalPages = Math.max(1, Math.ceil(all.length / PER_PAGE));
  // Generates /page/2 … /page/<totalPages> (page 1 is the root route).
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { page: i + 2, videos: all },
  }));
}

const { page, videos } = Astro.props;
---

<MainLayout
  videos={videos}
  title={`Video Catalog — Page ${page}`}
  description="Stream a curated catalog of tech, design, gaming and lifestyle videos. Zero-database: every video is a JSON file in a Git repo."
>
  <CatalogCanvas videos={videos} page={page} />
</MainLayout>
