---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import VideoCard from '../../components/VideoCard.astro';
import { relatedVideos } from '../../lib/related';
import { durationBadge, formatDate, relativeDate } from '../../lib/dates';
import { formatViews } from '../../lib/format';

export async function getStaticPaths() {
  const all = (await getCollection('videos')).sort(
    (a, b) => +b.data.publishedAt - +a.data.publishedAt
  );
  return all.map((v) => ({
    params: { id: v.id },
    props: {
      video: v,
      allVideos: all,
      // Related-videos engine: subcategory +3, category +1, shared tags +1 each.
      related: relatedVideos(v, all, 4),
    },
  }));
}

const { video, allVideos, related } = Astro.props;
const {
  title,
  description,
  thumbnailUrl,
  embedUrl,
  duration,
  publishedAt,
  category,
  subcategory,
  tags,
  views,
} = video.data;

/**
 * Schema.org VideoObject — injected into <head> on every video page for
 * Google Video Search indexing (name, description, thumbnails, upload
 * timestamp ISO 8601, exact duration ISO 8601, embed player URL).
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: title,
  description,
  thumbnailUrl: [thumbnailUrl],
  uploadDate: publishedAt.toISOString(),
  duration,
  embedUrl,
  contentUrl: embedUrl,
  genre: category,
  keywords: tags.join(', '),
};
---

<MainLayout
  videos={allVideos}
  title={title}
  description={description}
  ogImage={thumbnailUrl}
  ogType="video.other"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-5xl">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-500 transition hover:text-pink-500 dark:text-zinc-400 dark:hover:text-pink-300"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
        <path d="M15 18l-6-6 6-6" />
      </svg>
      Back to catalog
    </a>

    <!-- 16:9 responsive player — direct embed -->
    <div class="mt-4">
      <VideoPlayer embed={embedUrl} title={title} />
    </div>

    <h1 class="mt-6 text-2xl font-bold leading-tight tracking-tight sm:text-3xl">{title}</h1>

    <!-- Metadata breakdown: badges for date, duration and taxonomy links -->
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <time datetime={publishedAt.toISOString()} class="vv-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-3.5 w-3.5" aria-hidden="true">
          <rect x="3" y="5" width="18" height="16" rx="2" />
          <path d="M8 3v4m8-4v4M3 10h18" />
        </svg>
        {formatDate(publishedAt)} <span class="opacity-60">· {relativeDate(publishedAt)}</span>
      </time>
      <span class="vv-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-3.5 w-3.5" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 7v5l3 3" />
        </svg>
        {durationBadge(duration)}
      </span>
      <span class="vv-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5" aria-hidden="true">
          <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
          <circle cx="12" cy="12" r="3" />
        </svg>
        {formatViews(views)}
      </span>
      <a href={`/?cat=${encodeURIComponent(category)}`} class="vv-badge vv-badge-link" title="Browse {category}">
        {category}
      </a>
      <a
        href={`/?cat=${encodeURIComponent(category)}&sub=${encodeURIComponent(subcategory)}`}
        class="vv-badge vv-badge-link"
        title="Browse {subcategory}"
      >
        {subcategory}
      </a>
    </div>

    <!-- Full description (expandable when long) -->
    <div class="mt-5">
      <p id="vv-desc" class="max-w-3xl text-[15px] leading-relaxed text-zinc-600 dark:text-zinc-300">
        {description}
      </p>
      {description.length > 140 && (
        <button
          id="vv-desc-toggle"
          type="button"
          class="mt-1.5 text-sm font-semibold text-pink-500 transition hover:text-pink-400"
        >
          Read more
        </button>
      )}
    </div>

    <!-- Interactive tags → each tag runs a tag search -->
    <div class="mt-6 flex flex-wrap items-center gap-2">
      {tags.map((tag) => (
        <a href={`/?q=${encodeURIComponent(tag)}`} class="vv-tag" title={`Search videos tagged "${tag}"`}>
          #{tag}
        </a>
      ))}
    </div>

    <!-- Related videos (4-card grid, scored by subcategory + tags) -->
    <section class="mt-12">
      <h2 class="text-lg font-bold tracking-tight">Related Videos</h2>
      <p class="mt-0.5 text-sm text-zinc-500 dark:text-zinc-400">
        Matched by shared subcategory, category and tags.
      </p>
      <div class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {related.map((r) => <VideoCard video={r} />)}
      </div>
    </section>
  </div>

  <style>
    .vv-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      border-radius: 999px;
      padding: 0.4rem 0.85rem;
      font-size: 0.8rem;
      font-weight: 500;
      background: rgb(0 0 0 / 0.05);
      color: #374151;
      border: 1px solid rgb(0 0 0 / 0.08);
      text-decoration: none;
    }
    html.dark .vv-badge {
      background: rgb(255 255 255 / 0.06);
      color: #d4d4d8;
      border-color: rgb(255 255 255 / 0.1);
    }
    .vv-badge-link {
      cursor: pointer;
      transition: background-color 0.15s ease, color 0.15s ease;
    }
    .vv-badge-link:hover {
      background: rgb(236 72 153 / 0.15);
      color: #db2777;
    }
    html.dark .vv-badge-link:hover {
      color: #f9a8d4;
    }
    .vv-tag {
      border-radius: 999px;
      padding: 0.32rem 0.8rem;
      font-size: 0.8rem;
      font-weight: 500;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      background: color-mix(in oklab, #ec4899 10%, transparent);
      color: #db2777;
      border: 1px solid color-mix(in oklab, #ec4899 25%, transparent);
      text-decoration: none;
      transition: background-color 0.15s ease;
    }
    .vv-tag:hover {
      background: color-mix(in oklab, #ec4899 20%, transparent);
    }
    html.dark .vv-tag {
      color: #f9a8d4;
    }
  </style>

  <script>
    // Expandable description (clamped to 3 lines until "Read more")
    const t = document.getElementById('vv-desc-toggle');
    if (t) {
      const desc = document.getElementById('vv-desc');
      t.addEventListener('click', () => {
        const expanded = !desc.classList.toggle('line-clamp-3');
        t.textContent = expanded ? 'Show less' : 'Read more';
      });
      desc.classList.add('line-clamp-3');
    }
  </script>
</MainLayout>
